+#[test]
+fn ra9_temporal_building_sale_waits_for_real_release() {
+    ra9_temporal_building_sale(false);
+}
+
+#[test]
+fn ra9_temporal_building_sale_uses_an_unblocked_alternative_then_resumes() {
+    ra9_temporal_building_sale(true);
+}

+fn ra9_temporal_building_sale(other_live: bool) {
+    let mut app = scenario("russia", "easy", 0, 0, false);
+    let controllers = std::mem::take(&mut *app.world_mut().resource_mut::<sim::AiPlayers>());
+    let paused = put(&mut app, "gap_generator", 13, 12);
+    let other = other_live.then(|| put(&mut app, "sentry_gun", 3, 3));
+    for _ in 0..2 {
+        let world = app.world_mut();
+        for (id, owner, mut hp) in world
+            .query::<(&sim::SimId, &sim::Owner, &mut sim::Health)>()
+            .iter_mut(world)
+        {
+            if owner.0 == PlayerId(0) && *id != paused && Some(*id) != other {
+                hp.hit_points = 0;
+            }
+        }
+        step(&mut app);
+    }
+    app.world_mut().insert_resource(controllers);
+    let began = app.world().resource::<SimTick>().0;
+    for _ in 0..sim::LAST_STAND_PATIENCE - 200 {
+        step(&mut app);
+    }
+    let source = spawn_unit(
+        app.world_mut(),
+        PlayerId(1),
+        "chrono_legionnaire",
+        CellPos::new(18, 12),
+    )
+    .unwrap();
+    app.world_mut()
+        .resource_mut::<CommandQueue>()
+        .push(sim::IssuedCommand {
+            player: PlayerId(1),
+            command: Command::Guard {
+                units: vec![source],
+            },
+        });
+    step(&mut app);
+    app.world_mut()
+        .resource_mut::<CommandQueue>()
+        .push(sim::IssuedCommand {
+            player: PlayerId(1),
+            command: Command::Attack {
+                units: vec![source],
+                target: paused,
+            },
+        });
+    let mut native_shot = false;
+    for _ in 0..200 {
+        let events = step(&mut app);
+        native_shot |= events.iter().any(|e| matches!(e, sim::SimEvent::WeaponFired { attacker, target, .. } if *attacker == source && *target == paused));
+        if app
+            .world()
+            .resource::<sim::SpecialState>()
+            .erasures
+            .contains_key(&paused)
+        {
+            break;
+        }
+    }
+    assert!(
+        native_shot
+            && app
+                .world()
+                .resource::<sim::SpecialState>()
+                .erasures
+                .contains_key(&paused)
+    );
+    let mut other_sold = false;
+    while app.world().resource::<SimTick>().0 < began + sim::LAST_STAND_PATIENCE + 100 {
+        let events = step(&mut app);
+        assert!(
+            app.world()
+                .resource::<sim::SpecialState>()
+                .erasures
+                .contains_key(&paused)
+        );
+        assert!(
+            !app.world().resource::<CommandQueue>().iter().any(
+                |c| matches!(c.command, Command::SellBuilding { building } if building == paused)
+            ),
+            "current Temporal suspension must exclude only the sale candidate"
+        );
+        assert!(!events.iter().any(
+            |e| matches!(e, sim::SimEvent::BuildingSold { building, .. } if *building == paused)
+        ));
+        other_sold |= events.iter().any(|e| matches!(e, sim::SimEvent::BuildingSold { building, .. } if Some(*building) == other));
+    }
+    assert_eq!(
+        other_sold, other_live,
+        "a current live cheaper alternative must not be starved by the erased expensive building"
+    );
+    app.world_mut()
+        .resource_mut::<CommandQueue>()
+        .push(sim::IssuedCommand {
+            player: PlayerId(1),
+            command: Command::Move {
+                units: vec![source],
+                target: CellPos::new(30, 12),
+            },
+        });
+    step(&mut app);
+    assert!(
+        !app.world()
+            .resource::<sim::SpecialState>()
+            .erasures
+            .contains_key(&paused)
+    );
+    let mut resumed = false;
+    for _ in 0..sim::LAST_STAND_TURN + 80 {
+        let events = step(&mut app);
+        resumed |= events.iter().any(|e| matches!(e, sim::SimEvent::BuildingSold { player, building, .. } if *player == PlayerId(0) && *building == paused));
+        if resumed {
+            break;
+        }
+    }
+    assert!(
+        resumed,
+        "the genuine original building must resume ordinary sale after public native release; tick{} controller{:?} queue{:?} erasures{:?}",
+        app.world().resource::<SimTick>().0,
+        app.world()
+            .resource::<sim::AiPlayers>()
+            .controller(PlayerId(0)),
+        app.world().resource::<CommandQueue>(),
+        app.world().resource::<sim::SpecialState>().erasures
+    );
+}

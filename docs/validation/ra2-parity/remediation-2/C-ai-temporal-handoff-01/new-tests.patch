+#[test]
+fn ra9_temporal_garrison_waits_for_real_release_then_recovers_its_original_infantry() {
+    ra9_temporal_garrison_recovery(false, false);
+}
+
+#[test]
+fn ra9_temporal_garrison_does_not_starve_a_current_unblocked_recovery_host() {
+    ra9_temporal_garrison_recovery(true, false);
+}
+
+#[test]
+fn ra9_temporal_garrison_current_cargo_interrupts_an_existing_last_stand() {
+    ra9_temporal_garrison_recovery(false, true);
+}

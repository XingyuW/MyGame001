+
+// A surviving producer is a recovery path only if ordinary work can actually
+// be financed. Keep partially paid/completed heads and existing exact-refund
+// recovery; a cheap wallet alone must not renew futile repairs indefinitely.
+fn funded_army_recovery(view: &View<'_>, controller: &AiController) -> bool {
+    let cash = view.state.credits();
+    if view.state.queues().any(|(_, queue)| {
+        queue.first().is_some_and(|head| {
+            matches!(head.item, ProductionItem::Unit(kind) if view.ai.army.contains(&kind))
+                && production_can_advance(view, head.item)
+                && outstanding_cost(view, head) <= cash
+        })
+    }) || !recover_unit_credits(view, controller).is_empty()
+    {
+        return true;
+    }
+    // This is the existing ordinary sale policy, which excludes producers and
+    // prerequisites of the declared army; no hypothetical producer sale funds it.
+    let refund = match sell_for_army(view) {
+        Some(Command::SellBuilding { building }) => view.own_buildings.iter()
+            .find(|b| b.id == building)
+            .map_or(0, |b| view.definitions.refund(b.kind)),
+        _ => 0,
+    };
+    view.ai.army.iter().any(|&kind| {
+        let item = ProductionItem::Unit(kind);
+        view.buildable(item) && view.definitions.production(item)
+            .is_some_and(|terms| terms.cost <= cash.saturating_add(refund))
+    })
 }
 

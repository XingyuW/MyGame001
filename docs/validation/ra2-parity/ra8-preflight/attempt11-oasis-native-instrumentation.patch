+// One exact ending diagnosis: observations only, no commands or simulation state writes.
+fn trace_oasis_native(
+    world: &mut bevy::ecs::world::World,
+    definitions: &sim::Definitions,
+    events: &[SimEvent],
+    at: u64,
+) {
+    if std::env::var_os("RA8_OASIS_NATIVE_TRACE").is_none() {
+        return;
+    }
+    let tick = world.resource::<sim::SimTick>().0;
+    let snapshot = at % 6000 == 5999;
+    if snapshot {
+        for (player, state) in world.resource::<sim::Players>().iter() {
+            let queues: Vec<_> = state
+                .queues()
+                .map(|(key, q)| {
+                    let entries: Vec<_> = q
+                        .iter()
+                        .map(|head| {
+                            let name = match head.item {
+                                sim::ProductionItem::Unit(k) => {
+                                    definitions.unit(k).unwrap().id.as_str()
+                                }
+                                sim::ProductionItem::Building(k) => {
+                                    definitions.building(k).unwrap().id.as_str()
+                                }
+                            };
+                            let cost = definitions.production(head.item).unwrap().cost;
+                            (
+                                head.item,
+                                name,
+                                head.charged,
+                                cost.saturating_sub(head.charged),
+                            )
+                        })
+                        .collect();
+                    (key, entries)
+                })
+                .collect();
+            let ai = world.resource::<sim::AiPlayers>().controller(player);
+            eprintln!(
+                "oasis native loop{at} tick{tick} {player:?} credits{} power{}/{} repairing{:?} queues{queues:?} target{:?} wave{:?}",
+                state.credits(),
+                state.power_produced(),
+                state.power_consumed(),
+                state.repairing(),
+                ai.and_then(|c| c.target()),
+                ai.map(|c| c.wave())
+            );
+        }
+        for (id, owner, u, m, p, hp, orders, weapon) in world
+            .query::<(
+                &SimId,
+                &sim::Owner,
+                &sim::Unit,
+                &sim::Mobile,
+                &sim::Position,
+                &sim::Health,
+                &sim::Orders,
+                Option<&sim::Weapon>,
+            )>()
+            .iter(world)
+        {
+            eprintln!(
+                "oasis actor loop{at} tick{tick} {id:?} {owner:?} {} kind{:?} cell{:?} fine{:?} hp{} step{:?} order{:?} weapon{weapon:?}",
+                definitions.unit(u.kind).unwrap().id,
+                u.kind,
+                m.cell,
+                p.0,
+                hp.hit_points,
+                m.step,
+                orders
+                    .current
+                    .as_ref()
+                    .map(|o| (o.destination, o.best, &o.state))
+            );
+        }
+        for (id, owner, b, hp) in world
+            .query::<(&SimId, &sim::Owner, &sim::Building, &sim::Health)>()
+            .iter(world)
+        {
+            let special = world.resource::<sim::SpecialState>();
+            eprintln!(
+                "oasis building loop{at} tick{tick} {id:?} {owner:?} {} hp{} charge{:?} erasure{:?}",
+                definitions.building(b.kind).unwrap().id,
+                hp.hit_points,
+                special.charge.get(id),
+                special.erasures.get(id)
+            );
+        }
+    }
+    for event in events {
+        if let SimEvent::WeaponFired {
+            attacker,
+            target,
+            weapon,
+        } = event
+        {
+            let Some(terms) = definitions.weapon(*weapon) else {
+                continue;
+            };
+            if !definitions
+                .warhead(terms.warhead)
+                .is_some_and(|warhead| warhead.temporal)
+            {
+                continue;
+            }
+            for (id, owner, u, m, p) in world
+                .query::<(
+                    &SimId,
+                    &sim::Owner,
+                    &sim::Unit,
+                    &sim::Mobile,
+                    &sim::Position,
+                )>()
+                .iter(world)
+            {
+                if id == attacker {
+                    eprintln!(
+                        "oasis temporal loop{at} tick{tick} {id:?} {owner:?} {} cell{:?} fine{:?} target{target:?} weapon{:?} range{} erasure{:?}",
+                        definitions.unit(u.kind).unwrap().id,
+                        m.cell,
+                        p.0,
+                        weapon,
+                        terms.range,
+                        world.resource::<sim::SpecialState>().erasures.get(target)
+                    );
+                }
+            }
+            for (id, b, hp) in world
+                .query::<(&SimId, &sim::Building, &sim::Health)>()
+                .iter(world)
+            {
+                if id == target {
+                    eprintln!(
+                        "oasis temporal target loop{at} tick{tick} {id:?} {} footprint{:?} hp{}",
+                        definitions.building(b.kind).unwrap().id,
+                        b.footprint,
+                        hp.hit_points
+                    );
+                }
+            }
+        }
+    }
+}

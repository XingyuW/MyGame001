+#[test]
+fn ra8_russian_declared_opening_funds_real_siege_without_losing_its_tank() {
+    let mut app = scenario("russia", "medium", 1800, 0, false);
+    let controllers = std::mem::take(
+        app.world_mut()
+            .resource_mut::<sim::AiPlayers>()
+            .into_inner(),
+    );
+    let factory = put(&mut app, "soviet_war_factory", 5, 15);
+    put(&mut app, "soviet_barracks", 5, 12);
+    put(&mut app, "radar_tower", 15, 5);
+    put(&mut app, "tesla_reactor", 3, 5);
+    // Controlled production fixture: normal live source producers and prerequisites,
+    // but no construction lane competing for this declared finite opening wallet.
+    let world = app.world_mut();
+    let yards = world
+        .query::<(bevy_ecs::entity::Entity, &sim::Owner, &sim::Building)>()
+        .iter(world)
+        .filter(|(_, owner, b)| {
+            owner.0 == PlayerId(0)
+                && world
+                    .resource::<sim::Definitions>()
+                    .building(b.kind)
+                    .unwrap()
+                    .id
+                    == "soviet_construction_yard"
+        })
+        .map(|(entity, _, _)| entity)
+        .collect::<Vec<_>>();
+    assert_eq!(yards.len(), 1);
+    for yard in yards {
+        world.get_mut::<sim::Health>(yard).unwrap().hit_points = 0;
+    }
+    step(&mut app);
+    let world = app.world_mut();
+    let owned = world
+        .query::<(&sim::Owner, &sim::Building)>()
+        .iter(world)
+        .filter(|(o, _)| o.0 == PlayerId(0))
+        .map(|(_, b)| b.kind)
+        .collect::<Vec<_>>();
+    let defs = world.resource::<sim::Definitions>();
+    let v3 = defs.unit_kind("v3_launcher").unwrap();
+    let rhino = defs.unit_kind("rhino").unwrap();
+    for (kind, price) in [(v3, 800), (rhino, 900)] {
+        let item = sim::ProductionItem::Unit(kind);
+        assert_eq!(defs.production(item).unwrap().cost, price);
+        assert!(
+            sim::check_buildable(
+                defs,
+                world.resource::<sim::Players>().get(PlayerId(0)).unwrap(),
+                false,
+                &owned,
+                item
+            )
+            .is_ok(),
+            "both source candidates must actually be legal before admission"
+        );
+    }
+    assert_eq!(
+        world
+            .resource::<sim::Players>()
+            .get(PlayerId(0))
+            .unwrap()
+            .credits(),
+        1800
+    );
+    app.world_mut().insert_resource(controllers);
+    let mut charged = std::collections::BTreeSet::new();
+    let mut born = Vec::new();
+    for _ in 0..2500 {
+        for (_, queue) in app
+            .world()
+            .resource::<sim::Players>()
+            .get(PlayerId(0))
+            .unwrap()
+            .queues()
+        {
+            for head in queue {
+                if head.charged > 0 {
+                    charged.insert(head.item);
+                }
+            }
+        }
+        for event in step(&mut app) {
+            assert!(!matches!(
+                event,
+                sim::SimEvent::BuildingSold {
+                    player: PlayerId(0),
+                    ..
+                } | sim::SimEvent::ProductionCancelled {
+                    player: PlayerId(0),
+                    ..
+                } | sim::SimEvent::OreDelivered {
+                    player: PlayerId(0),
+                    ..
+                }
+            ));
+            if let sim::SimEvent::UnitSpawned {
+                player: PlayerId(0),
+                building,
+                unit,
+            } = event
+                && building == factory
+            {
+                let entity = unit_entity(&mut app, unit);
+                born.push(app.world().get::<sim::Unit>(entity).unwrap().kind);
+            }
+        }
+        if born.len() == 2 {
+            break;
+        }
+    }
+    eprintln!("Russian finite factory opening charged{charged:?} born{born:?}");
+    assert_eq!(
+        born,
+        vec![v3, rhino],
+        "the declared opening must pay for and physically spawn a siege/tank pair"
+    );
+    for kind in [v3, rhino] {
+        assert!(charged.contains(&sim::ProductionItem::Unit(kind)));
+    }
+    assert!(
+        app.world()
+            .resource::<sim::MatchState>()
+            .outcome()
+            .is_none()
+    );
+    assert!(
+        app.world()
+            .resource::<sim::MatchState>()
+            .defeated(PlayerId(0))
+            .is_none()
+    );
+}

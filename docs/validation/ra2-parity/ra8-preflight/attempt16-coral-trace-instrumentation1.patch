+// Temporary observation only: this state lives in an Arc outside the World and never issues a command.
+#[derive(Default)]
+struct DuelTrace {
+    pre: std::collections::BTreeMap<u8, String>,
+    last: std::collections::BTreeMap<u8, String>,
+    shots: std::collections::BTreeMap<String, u64>,
+    moves: std::collections::BTreeMap<String, u64>,
+    counts: std::collections::BTreeMap<String, u64>,
+}
+
+fn trace_ai(
+    world: &mut bevy_ecs::world::World,
+    stage: &str,
+    shared: &std::sync::Arc<Mutex<DuelTrace>>,
+) {
+    let tick = world.resource::<sim::SimTick>().0;
+    let mut trace = shared.lock().unwrap();
+    for player in 0..2_u8 {
+        let Some(c) = world
+            .resource::<sim::AiPlayers>()
+            .controller(PlayerId(player))
+        else {
+            continue;
+        };
+        let interval = u64::from(c.difficulty().think_interval.max(1));
+        if tick % interval != u64::from(player) % interval && tick % 256 != u64::from(player) {
+            continue;
+        }
+        let key = format!(
+            "target{:?} naval{:?} wave{:?} known{:?}",
+            c.target(),
+            c.naval_target(),
+            c.wave(),
+            c.known_buildings()
+        );
+        if stage == "before" {
+            trace.pre.insert(player, key);
+            continue;
+        }
+        let before = trace.pre.get(&player).cloned().unwrap_or_default();
+        if trace.last.get(&player) != Some(&key) || tick % 3000 <= 1 {
+            let state = world
+                .resource::<sim::Players>()
+                .get(PlayerId(player))
+                .unwrap();
+            println!(
+                "TRACE AI tick{tick} player{player} pre[{before}] post[{key}] credits{} power{}/{} low{} issued{}",
+                state.credits(),
+                state.power_produced(),
+                state.power_consumed(),
+                state.low_power(),
+                c.commands_issued()
+            );
+            trace.last.insert(player, key);
+        }
+        if tick >= 240000 && tick % 3000 < interval {
+            let issued: Vec<_> = world.resource::<sim::CommandQueue>().iter().collect();
+            println!("TRACE FIFO tick{tick} player{player} {issued:?}");
+        }
+    }
+}
+
+fn trace_tick(world: &mut bevy_ecs::world::World, shared: &std::sync::Arc<Mutex<DuelTrace>>) {
+    let tick = world.resource::<sim::SimTick>().0;
+    let events: Vec<_> = world
+        .resource::<bevy_ecs::message::Messages<sim::SimEvent>>()
+        .iter_current_update_messages()
+        .cloned()
+        .collect();
+    let definitions = world.resource::<sim::Definitions>().clone();
+    {
+        let mut trace = shared.lock().unwrap();
+        for event in &events {
+            let text = format!("{event:?}");
+            *trace
+                .counts
+                .entry(text.split([' ', '{']).next().unwrap_or("").to_owned())
+                .or_default() += 1;
+            match event {
+                sim::SimEvent::WeaponFired {
+                    attacker,
+                    target,
+                    weapon,
+                } => {
+                    let name = definitions
+                        .weapon(*weapon)
+                        .map(|w| w.id.as_str())
+                        .unwrap_or("unknown");
+                    *trace
+                        .shots
+                        .entry(format!("{attacker:?}->{target:?} {name}"))
+                        .or_default() += 1;
+                }
+                sim::SimEvent::MoveFailed { .. }
+                | sim::SimEvent::MoveCompleted { .. }
+                | sim::SimEvent::AttackEnded { .. } => {
+                    *trace.moves.entry(text).or_default() += 1;
+                }
+                sim::SimEvent::OreDelivered { .. }
+                | sim::SimEvent::ProjectileExpired { .. }
+                | sim::SimEvent::Impact { .. }
+                | sim::SimEvent::DamageStateChanged { .. } => {}
+                _ => println!("TRACE EVENT tick{tick} {text}"),
+            }
+        }
+        if tick % 3000 == 0
+            || world.resource::<MatchState>().outcome().is_some()
+            || tick == END_LIMIT
+        {
+            println!(
+                "TRACE WINDOW end{tick} counts{:?} shots{:?} moves{:?}",
+                trace.counts, trace.shots, trace.moves
+            );
+            trace.counts.clear();
+            trace.shots.clear();
+            trace.moves.clear();
+        }
+    }
+    for event in &events {
+        if let sim::SimEvent::UnitSpawned { unit, .. } = event {
+            let mut query = world.query::<(&sim::SimId, &Unit, &Owner, &Mobile)>();
+            for (id, u, o, m) in query.iter(world).filter(|(id, _, _, _)| id == &unit) {
+                println!(
+                    "TRACE BIRTH tick{tick} {id:?} owner{o:?} kind{} mobile{m:?}",
+                    definitions.unit(u.kind).unwrap().id
+                );
+            }
+        }
+    }
+    if tick % 3000 != 0 && tick != END_LIMIT && world.resource::<MatchState>().outcome().is_none() {
+        return;
+    }
+    println!("TRACE SNAPSHOT tick{tick}");
+    for player in 0..2_u8 {
+        let state = world
+            .resource::<sim::Players>()
+            .get(PlayerId(player))
+            .unwrap();
+        println!(
+            "TRACE ECON tick{tick} player{player} credits{} power{}/{} low{} queues{:?}",
+            state.credits(),
+            state.power_produced(),
+            state.power_consumed(),
+            state.low_power(),
+            state.queues().collect::<Vec<_>>()
+        );
+        if let Some(c) = world
+            .resource::<sim::AiPlayers>()
+            .controller(PlayerId(player))
+        {
+            let debug = format!("{c:?}");
+            for (start, end) in [
+                ("failures: ", ", next_army:"),
+                ("patience_until: ", ", next_harvest:"),
+                ("staging: ", ", waves_sent:"),
+                ("next_wave: ", ", seen_air:"),
+                ("reserved: ", ", naval_goal:"),
+                ("naval_site: ", ", next_naval_scan:"),
+                ("building_jobs: ", ""),
+            ] {
+                let value = debug.split_once(start).map(|(_, tail)| {
+                    if end.is_empty() {
+                        tail
+                    } else {
+                        tail.split_once(end).map_or(tail, |(value, _)| value)
+                    }
+                });
+                println!("TRACE CTRL tick{tick} player{player} {start}{value:?}");
+            }
+            for (id, known) in c.known_buildings() {
+                let cells: Vec<_> = known
+                    .footprint
+                    .cells()
+                    .map(|cell| (cell, state.vision().is_visible(cell)))
+                    .collect();
+                println!(
+                    "TRACE KNOWN tick{tick} player{player} {id:?} owner{:?} kind{} footprint{:?} cells{cells:?}",
+                    known.owner,
+                    definitions.building(known.kind).unwrap().id,
+                    known.footprint
+                );
+            }
+        }
+    }
+    let mut query = world.query::<(
+        &sim::SimId,
+        &Owner,
+        Option<&Unit>,
+        Option<&Building>,
+        Option<&Mobile>,
+        Option<&sim::Health>,
+        Option<&sim::Sight>,
+        Option<&sim::Weapon>,
+        Option<&sim::Orders>,
+        Option<&sim::Harvester>,
+    )>();
+    let grid = world.resource::<Grid>();
+    for (id, owner, unit, building, mobile, health, sight, weapon, orders, harvest) in
+        query.iter(world)
+    {
+        if let Some(unit) = unit {
+            println!(
+                "TRACE UNIT tick{tick} {id:?} {owner:?} kind{} hp{health:?} sight{sight:?} mobile{mobile:?} fine{:?} weapon{weapon:?} orders{orders:?} harvest{harvest:?}",
+                definitions.unit(unit.kind).unwrap().id,
+                mobile.map(|m| m.position(grid, *id))
+            );
+        }
+        if let Some(building) = building {
+            let seen: Vec<_> = (0..2_u8)
+                .map(|p| {
+                    (
+                        p,
+                        world
+                            .resource::<sim::Players>()
+                            .get(PlayerId(p))
+                            .unwrap()
+                            .vision()
+                            .sees_footprint(building.footprint),
+                    )
+                })
+                .collect();
+            println!(
+                "TRACE BUILDING tick{tick} {id:?} {owner:?} kind{} hp{health:?} sight{sight:?} footprint{:?} seen{seen:?}",
+                definitions.building(building.kind).unwrap().id,
+                building.footprint
+            );
+        }
+    }
+    let special = world.resource::<sim::SpecialState>();
+    println!(
+        "TRACE SPECIAL tick{tick} charge{:?} disabled{:?} erasures{:?} protected{:?} cargo{:?} garrisons{:?} docked{:?} outages{:?}",
+        special.charge,
+        special.disabled,
+        special.erasures,
+        special.protected,
+        special.cargo,
+        special.garrisons,
+        special.docked,
+        special.outages
+    );
+}

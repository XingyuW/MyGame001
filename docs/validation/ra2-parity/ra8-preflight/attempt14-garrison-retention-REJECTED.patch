+
+#[test]
+fn ra8_unfunded_idle_garrison_reinforces_a_living_offensive_force() {
+    let mut app = scenario("russia", "easy", 62, 0, false);
+    let controllers = std::mem::take(&mut *app.world_mut().resource_mut::<sim::AiPlayers>());
+    let remnant = put(&mut app, "radar_tower", 15, 8);
+    for _ in 0..2 {
+        let world = app.world_mut();
+        for (id, owner, mut hp) in world
+            .query::<(&sim::SimId, &sim::Owner, &mut sim::Health)>()
+            .iter_mut(world)
+        {
+            if owner.0 == PlayerId(0) && *id != remnant {
+                hp.hit_points = 0;
+            }
+        }
+        step(&mut app);
+    }
+    let host = civilian(&mut app, CellPos::new(13, 8));
+    let infantry = spawn_unit(
+        app.world_mut(),
+        PlayerId(0),
+        "conscript",
+        CellPos::new(12, 8),
+    )
+    .unwrap();
+    let enemy = sim::spawn_building(
+        app.world_mut(),
+        PlayerId(1),
+        "tesla_reactor",
+        CellPos::new(27, 8),
+    )
+    .unwrap();
+    // A real unarmed observer establishes the intended building objective;
+    // the released infantry must not depend on a seeded controller memory.
+    spawn_unit(
+        app.world_mut(),
+        PlayerId(0),
+        "engineer",
+        CellPos::new(25, 10),
+    )
+    .unwrap();
+    step(&mut app);
+    issue(
+        &mut app,
+        Command::Interact {
+            unit: infantry,
+            target: host,
+        },
+    );
+    for _ in 0..40 {
+        step(&mut app);
+        if app
+            .world()
+            .resource::<sim::SpecialState>()
+            .cargo
+            .get(&host)
+            .is_some_and(|cargo| cargo.iter().any(|p| p.id == infantry))
+        {
+            break;
+        }
+    }
+    assert!(
+        app.world().resource::<sim::SpecialState>().cargo[&host]
+            .iter()
+            .any(|p| p.id == infantry)
+    );
+    assert_eq!(
+        app.world()
+            .resource::<sim::Players>()
+            .get(PlayerId(0))
+            .unwrap()
+            .credits(),
+        62
+    );
+    let definitions = app.world().resource::<sim::Definitions>();
+    assert_eq!(
+        definitions
+            .production(sim::ProductionItem::Unit(
+                definitions.unit_kind("conscript").unwrap()
+            ))
+            .unwrap()
+            .cost,
+        100
+    );
+    // Controlled live field-force setup: this capable actor prevents the
+    // existing helplessness recovery path from evacuating the occupied host.
+    let field = spawn_unit(
+        app.world_mut(),
+        PlayerId(0),
+        "conscript",
+        CellPos::new(12, 12),
+    )
+    .unwrap();
+    app.world_mut().insert_resource(controllers);
+    let mut field_shot = false;
+    let mut host_shot = false;
+    let mut exit_issued = false;
+    let mut released = false;
+    let mut shot = false;
+    for _ in 0..7000 {
+        let events = step(&mut app);
+        let world = app.world_mut();
+        field_shot |= events.iter().any(|e| matches!(e, sim::SimEvent::WeaponFired { attacker, target, .. } if *attacker == field && *target == enemy));
+        host_shot |= events
+            .iter()
+            .any(|e| matches!(e, sim::SimEvent::WeaponFired { attacker, .. } if *attacker == host));
+        exit_issued |= world
+            .resource::<CommandQueue>()
+            .iter()
+            .any(|c| matches!(c.command, Command::Deploy { unit } if unit == host));
+        let live = world
+            .query::<(&sim::SimId, &sim::Owner, &sim::Unit)>()
+            .iter(world)
+            .any(|(id, owner, _)| *id == infantry && owner.0 == PlayerId(0));
+        released |= live;
+        if released {
+            assert!(!world.resource::<CommandQueue>().iter().any(|c| matches!(c.command, Command::Interact { unit, target } if unit == infantry && target == host)), "unfunded released infantry was immediately regarrisoned");
+        }
+        shot |= events.iter().any(|e| matches!(e, sim::SimEvent::WeaponFired { attacker, target, .. } if *attacker == infantry && *target == enemy));
+        if shot && field_shot {
+            break;
+        }
+        assert!(world.resource::<sim::MatchState>().outcome().is_none());
+        assert!(
+            world
+                .resource::<sim::MatchState>()
+                .defeated(PlayerId(0))
+                .is_none()
+        );
+    }
+    assert!(
+        field_shot,
+        "the actual living field infantry must already contribute against the known building"
+    );
+    assert!(
+        !host_shot,
+        "the remote occupied host has no current native defensive shot"
+    );
+    assert!(
+        released && exit_issued,
+        "an unfunded idle garrison must use ordinary Deploy to reinforce the real offensive force"
+    );
+    let units = {
+        let world = app.world_mut();
+        world
+            .query::<(&sim::SimId, &sim::Mobile, &sim::Weapon)>()
+            .iter(world)
+            .map(|(id, m, w)| (*id, *m, *w))
+            .collect::<Vec<_>>()
+    };
+    assert!(
+        shot,
+        "the recovered source infantry must actually fire on the known enemy building; controller {:?}; units {units:?}",
+        app.world().resource::<sim::AiPlayers>()
+    );
+}

+// TRACE-INSTRUMENTATION (scratch, never committed).
+struct Trace {
+    ticks: u64,
+    sum: u64,
+    plain: u64,
+}
+impl Drop for Trace {
+    fn drop(&mut self) {
+        use std::io::Write;
+        if self.ticks == 0 {
+            return;
+        }
+        let Some(path) = std::env::var_os("SIM_HASH_TRACE") else {
+            return;
+        };
+        let name = std::thread::current()
+            .name()
+            .unwrap_or("<unnamed>")
+            .to_owned();
+        let line = format!("{name}\t{}\t{:016x}\t{}\n", self.ticks, self.sum, self.plain);
+        if let Ok(mut file) = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+        {
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
+thread_local! {
+    static TRACE: std::cell::RefCell<Trace> = const { std::cell::RefCell::new(Trace { ticks: 0, sum: 0, plain: 0 }) };
+}
+fn trace_hash(world: &mut bevy_ecs::world::World) {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("SIM_HASH_TRACE").is_some()) {
+        return;
+    }
+    let hash = crate::hash::hash_state(world, false);
+    TRACE.with(|trace| {
+        let mut trace = trace.borrow_mut();
+        trace.ticks += 1;
+        trace.sum = trace.sum.wrapping_mul(31).wrapping_add(hash);
+        trace.plain = trace.plain.wrapping_add(hash);
+    });
+}

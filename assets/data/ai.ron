// The computer player's definitions, schema version 1 (PLAN.md section 7, M6; docs/DECISIONS.md
// D42).
//
// build_order:  building types in the order the computer player builds them; a type listed n
//               times is kept at n buildings, so lost buildings are rebuilt. A power building is
//               built first whenever the next building would leave the player short of power.
//               Prerequisites come before the buildings that need them.
// power:        the building type built for power
// harvester:    the harvester unit type
// army:         armed unit types, produced in this order, cyclically
// difficulties: id; think_interval (ticks between two decisions, 20 per second);
//               harvesters_per_refinery; max_army (armed units it builds up to); wave_size (armed
//               units at home that start an attack wave); first_wave (the tick from which waves
//               may start); wave_patience (ticks after first_wave or the last wave after which
//               the units at home attack even if fewer than wave_size); defence_radius (visible enemies this many cells from its buildings are
//               attacked by its army at home)
(
    schema_version: 1,
    build_order: [
        "power_plant",
        "refinery",
        "barracks",
        "war_factory",
        "gun_turret",
        "power_plant",
        "refinery",
        "gun_turret",
    ],
    power: "power_plant",
    harvester: "harvester",
    army: ["light_tank", "light_tank", "scout"],
    difficulties: [
        (
            id: "easy",
            think_interval: 40,
            harvesters_per_refinery: 1,
            max_army: 8,
            wave_size: 6,
            first_wave: 6000,
            wave_patience: 3600,
            defence_radius: 8,
        ),
        (
            id: "normal",
            think_interval: 20,
            harvesters_per_refinery: 2,
            max_army: 16,
            wave_size: 8,
            first_wave: 3600,
            wave_patience: 2400,
            defence_radius: 10,
        ),
        (
            id: "hard",
            think_interval: 10,
            harvesters_per_refinery: 2,
            max_army: 30,
            wave_size: 10,
            first_wave: 2400,
            wave_patience: 1800,
            defence_radius: 12,
        ),
    ],
)

// Combat definitions, schema version 1 (PLAN.md sections 5 and 7, M4; docs/DECISIONS.md D28).
//
// armour_classes: the armour classes, names as in units.ron
// warheads:   the percentage of a weapon's base damage each warhead deals against every armour
//             class (equation 2: damage = base x percent / 100, rounded down, at least 1 unless
//             the percentage is 0); every armour class exactly once
// weapons:    base damage; range in subcells (256 per cell; at least 384); reload in ticks
//             (20 per second); warhead; projectile_speed in subcells per tick, or 0 for an
//             instant weapon
// units:      hit points, armour class, sight radius in cells, and at most one weapon of every
//             unit type of units.ron
// buildings:  the same for every building type of economy.ron; a building with a weapon is a
//             defensive structure, which does not fire under low power
//
// Balance data (M7, docs/DECISIONS.md D51): bullets are for infantry (and harm buildings, so that
// a small force can still finish a base), armour-piercing shells and rockets for vehicles,
// explosives for both, and artillery shells for buildings.
(
    schema_version: 1,
    armour_classes: ["infantry", "light", "heavy", "structure", "air", "naval", "submerged"],
    warheads: [
        (
            id: "bullet",
            versus: [
                (armour: "infantry", percent: 100),
                (armour: "light", percent: 50),
                (armour: "heavy", percent: 15),
                (armour: "structure", percent: 60),
                (armour: "air", percent: 0), (armour: "naval", percent: 60), (armour: "submerged", percent: 0),
            ],
        ),
        (
            id: "armour_piercing",
            versus: [
                (armour: "infantry", percent: 35),
                (armour: "light", percent: 80),
                (armour: "heavy", percent: 100),
                (armour: "structure", percent: 50),
                (armour: "air", percent: 0), (armour: "naval", percent: 50), (armour: "submerged", percent: 0),
            ],
        ),
        (
            id: "rocket",
            versus: [
                (armour: "infantry", percent: 30),
                (armour: "light", percent: 100),
                (armour: "heavy", percent: 100),
                (armour: "structure", percent: 70),
                (armour: "air", percent: 0), (armour: "naval", percent: 70), (armour: "submerged", percent: 0),
            ],
        ),
        (
            id: "high_explosive",
            versus: [
                (armour: "infantry", percent: 100),
                (armour: "light", percent: 75),
                (armour: "heavy", percent: 50),
                (armour: "structure", percent: 80),
                (armour: "air", percent: 0), (armour: "naval", percent: 80), (armour: "submerged", percent: 0),
            ],
        ),
        (
            id: "shell",
            versus: [
                (armour: "infantry", percent: 90),
                (armour: "light", percent: 60),
                (armour: "heavy", percent: 40),
                (armour: "structure", percent: 100),
                (armour: "air", percent: 0), (armour: "naval", percent: 100), (armour: "submerged", percent: 0),
            ],
        ),
        (id: "anti_air", versus: [(armour: "infantry", percent: 0), (armour: "light", percent: 0), (armour: "heavy", percent: 0), (armour: "structure", percent: 0), (armour: "air", percent: 100), (armour: "naval", percent: 0), (armour: "submerged", percent: 0)]),
        (id: "flak", versus: [(armour: "infantry", percent: 50), (armour: "light", percent: 30), (armour: "heavy", percent: 15), (armour: "structure", percent: 15), (armour: "air", percent: 100), (armour: "naval", percent: 40), (armour: "submerged", percent: 0)]),
        (id: "anti_infantry", versus: [(armour: "infantry", percent: 100), (armour: "light", percent: 0), (armour: "heavy", percent: 0), (armour: "structure", percent: 0), (armour: "air", percent: 0), (armour: "naval", percent: 0), (armour: "submerged", percent: 0)]),
        (id: "anti_vehicle", versus: [(armour: "infantry", percent: 0), (armour: "light", percent: 100), (armour: "heavy", percent: 100), (armour: "structure", percent: 0), (armour: "air", percent: 0), (armour: "naval", percent: 80), (armour: "submerged", percent: 0)]),
        (id: "naval", versus: [(armour: "infantry", percent: 25), (armour: "light", percent: 50), (armour: "heavy", percent: 50), (armour: "structure", percent: 50), (armour: "air", percent: 0), (armour: "naval", percent: 100), (armour: "submerged", percent: 100)]),
        (id: "torpedo", versus: [(armour: "infantry", percent: 0), (armour: "light", percent: 0), (armour: "heavy", percent: 0), (armour: "structure", percent: 0), (armour: "air", percent: 0), (armour: "naval", percent: 100), (armour: "submerged", percent: 100)]),
        (id: "omni", versus: [(armour: "infantry", percent: 50), (armour: "light", percent: 100), (armour: "heavy", percent: 100), (armour: "structure", percent: 100), (armour: "air", percent: 100), (armour: "naval", percent: 100), (armour: "submerged", percent: 0)]),
        (id: "control", versus: [(armour: "infantry", percent: 100), (armour: "light", percent: 100), (armour: "heavy", percent: 100), (armour: "structure", percent: 0), (armour: "air", percent: 0), (armour: "naval", percent: 0), (armour: "submerged", percent: 0)]),
    ],
    weapons: [
        (

// Combat definitions, schema version 1 (PLAN.md sections 5 and 7, M4; docs/DECISIONS.md D28).
//
// armour_classes: the armour classes, names as in units.ron
// warheads:   the percentage of a weapon's base damage each warhead deals against every armour
//             class (equation 2: damage = base x percent / 100, rounded down, at least 1 unless
//             the percentage is 0); every armour class exactly once
// weapons:    base damage; range in subcells (256 per cell; at least 384); reload in ticks
//             (20 per second); warhead; projectile_speed in subcells per tick, or 0 for an
//             instant weapon
// units:      hit points, armour class, sight radius in cells, and at most one weapon of every
//             unit type of units.ron
// buildings:  the same for every building type of economy.ron; a building with a weapon is a
//             defensive structure, which does not fire under low power
//
// Balance data (M7, docs/DECISIONS.md D51): bullets are for infantry (and harm buildings, so that
// a small force can still finish a base), armour-piercing shells and rockets for vehicles,
// explosives for both, and artillery shells for buildings.
(
    schema_version: 1,
    armour_classes: ["infantry", "light", "heavy", "structure"],
    warheads: [
        (
            id: "bullet",
            versus: [
                (armour: "infantry", percent: 100),
                (armour: "light", percent: 50),
                (armour: "heavy", percent: 15),
                (armour: "structure", percent: 60),
            ],
        ),
        (
            id: "armour_piercing",
            versus: [
                (armour: "infantry", percent: 35),
                (armour: "light", percent: 80),
                (armour: "heavy", percent: 100),
                (armour: "structure", percent: 50),
            ],
        ),
        (
            id: "rocket",
            versus: [
                (armour: "infantry", percent: 30),
                (armour: "light", percent: 100),
                (armour: "heavy", percent: 100),
                (armour: "structure", percent: 70),
            ],
        ),
        (
            id: "high_explosive",
            versus: [
                (armour: "infantry", percent: 100),
                (armour: "light", percent: 75),
                (armour: "heavy", percent: 50),
                (armour: "structure", percent: 80),
            ],
        ),
        (
            id: "shell",
            versus: [
                (armour: "infantry", percent: 90),
                (armour: "light", percent: 60),
                (armour: "heavy", percent: 40),
                (armour: "structure", percent: 100),
            ],
        ),
    ],
    weapons: [
        (
            id: "rifle",
            damage: 14,
            range: 1024,
            reload: 15,
            warhead: "bullet",
            projectile_speed: 0,
        ),
        (
            id: "carbine",
            damage: 12,
            range: 896,
            reload: 14,
            warhead: "bullet",
            projectile_speed: 0,
        ),
        (
            id: "infantry_rocket",
            damage: 45,
            range: 1280,
            reload: 40,
            warhead: "rocket",
            projectile_speed: 192,
        ),
        (
            id: "grenade",
            damage: 35,
            range: 1024,
            reload: 35,
            warhead: "high_explosive",
            projectile_speed: 128,
        ),
        (
            id: "scout_gun",
            damage: 9,
            range: 1024,
            reload: 8,
            warhead: "bullet",
            projectile_speed: 0,
        ),
        (
            id: "raider_gun",
            damage: 10,
            range: 1024,
            reload: 8,
            warhead: "bullet",
            projectile_speed: 0,
        ),
        (
            id: "tank_cannon",
            damage: 40,
            range: 1280,
            reload: 30,
            warhead: "armour_piercing",
            projectile_speed: 160,
        ),
        (
            id: "heavy_cannon",
            damage: 60,
            range: 1280,
            reload: 36,
            warhead: "armour_piercing",
            projectile_speed: 160,
        ),
        (
            id: "artillery_shell",
            damage: 80,
            range: 2560,
            reload: 75,
            warhead: "shell",
            projectile_speed: 128,
        ),
        (
            id: "rocket_salvo",
            damage: 70,
            range: 2304,
            reload: 70,
            warhead: "rocket",
            projectile_speed: 192,
        ),
        (
            id: "turret_gun",
            damage: 50,
            range: 1536,
            reload: 35,
            warhead: "high_explosive",
            projectile_speed: 192,
        ),
        (
            id: "tower_rocket",
            damage: 45,
            range: 1792,
            reload: 40,
            warhead: "high_explosive",
            projectile_speed: 224,
        ),
    ],
    units: [
        (unit: "rifleman", hit_points: 100, armour: "infantry", sight: 6, weapons: ["rifle"]),
        (unit: "rocket_soldier", hit_points: 90, armour: "infantry", sight: 6, weapons: ["infantry_rocket"]),
        (unit: "conscript", hit_points: 120, armour: "infantry", sight: 6, weapons: ["carbine"]),
        (unit: "grenadier", hit_points: 100, armour: "infantry", sight: 6, weapons: ["grenade"]),
        (unit: "scout", hit_points: 120, armour: "light", sight: 8, weapons: ["scout_gun"]),
        (unit: "raider", hit_points: 140, armour: "light", sight: 8, weapons: ["raider_gun"]),
        (unit: "light_tank", hit_points: 300, armour: "heavy", sight: 6, weapons: ["tank_cannon"]),
        (unit: "heavy_tank", hit_points: 480, armour: "heavy", sight: 6, weapons: ["heavy_cannon"]),
        (unit: "artillery", hit_points: 160, armour: "light", sight: 5, weapons: ["artillery_shell"]),
        (unit: "rocket_launcher", hit_points: 170, armour: "light", sight: 5, weapons: ["rocket_salvo"]),
        (unit: "harvester", hit_points: 600, armour: "heavy", sight: 4, weapons: []),
    ],
    buildings: [
        (building: "construction_yard", hit_points: 1100, armour: "structure", sight: 5, weapons: []),
        (building: "power_plant", hit_points: 450, armour: "structure", sight: 4, weapons: []),
        (building: "refinery", hit_points: 750, armour: "structure", sight: 4, weapons: []),
        (building: "barracks", hit_points: 450, armour: "structure", sight: 4, weapons: []),
        (building: "war_factory", hit_points: 900, armour: "structure", sight: 4, weapons: []),
        (building: "tech_center", hit_points: 650, armour: "structure", sight: 5, weapons: []),
        (building: "gun_turret", hit_points: 450, armour: "structure", sight: 7, weapons: ["turret_gun"]),
        (building: "rocket_tower", hit_points: 400, armour: "structure", sight: 7, weapons: ["tower_rocket"]),
    ],
)

        (id: "wheel_of_worlds", starts: [(x: 32, y: 96), (x: 221, y: 157), (x: 186, y: 46), (x: 67, y: 207), (x: 68, y: 46), (x: 185, y: 207), (x: 222, y: 96), (x: 31, y: 157), (x: 127, y: 27), (x: 126, y: 226)]),
    ],

        (id: "ember_caldera", starts: [(x: 95, y: 33), (x: 158, y: 220), (x: 33, y: 95), (x: 220, y: 158), (x: 159, y: 33), (x: 94, y: 220), (x: 33, y: 159), (x: 220, y: 94)]),

// RA1 fixture: combat terms of the small two sided world. Bullets harm infantry and, a little,
// buildings; shells harm everything. Fixture data (invariant I10).
(
    schema_version: 1,
    armour_classes: ["flesh", "plate", "concrete"],
    warheads: [
        (id: "bullet", versus: [(armour: "flesh", percent: 100), (armour: "plate", percent: 20), (armour: "concrete", percent: 10)]),
        (id: "shell", versus: [(armour: "flesh", percent: 50), (armour: "plate", percent: 100), (armour: "concrete", percent: 100)]),
    ],
    weapons: [
        (id: "rifle", damage: 10, range: 1024, reload: 10, warhead: "bullet", projectile_speed: 0),
        (id: "long_rifle", damage: 60, range: 2048, reload: 40, warhead: "bullet", projectile_speed: 0),
        (id: "cannon", damage: 40, range: 1280, reload: 25, warhead: "shell", projectile_speed: 0),
        (id: "big_cannon", damage: 60, range: 1280, reload: 30, warhead: "shell", projectile_speed: 0),
    ],
    units: [
        (unit: "allied_mcv", hit_points: 600, armour: "plate", sight: 6, weapons: []),
        (unit: "soviet_mcv", hit_points: 600, armour: "plate", sight: 6, weapons: []),
        (unit: "rifleman", hit_points: 100, armour: "flesh", sight: 6, weapons: ["rifle"]),
        (unit: "conscript", hit_points: 90, armour: "flesh", sight: 6, weapons: ["rifle"]),
        (unit: "engineer", hit_points: 60, armour: "flesh", sight: 5, weapons: []),
        (unit: "sniper", hit_points: 80, armour: "flesh", sight: 9, weapons: ["long_rifle"]),
        (unit: "raider", hit_points: 120, armour: "flesh", sight: 7, weapons: ["rifle"]),
        (unit: "militia", hit_points: 70, armour: "flesh", sight: 5, weapons: ["rifle"]),
        (unit: "prototype", hit_points: 100, armour: "flesh", sight: 5, weapons: ["rifle"]),
        (unit: "advanced", hit_points: 100, armour: "flesh", sight: 5, weapons: ["rifle"]),
        (unit: "tank", hit_points: 300, armour: "plate", sight: 7, weapons: ["cannon"]),
        (unit: "heavy", hit_points: 400, armour: "plate", sight: 7, weapons: ["big_cannon"]),
        (unit: "miner_a", hit_points: 400, armour: "plate", sight: 4, weapons: []),
        (unit: "miner_s", hit_points: 400, armour: "plate", sight: 4, weapons: []),
    ],
    buildings: [
        (building: "allied_yard", hit_points: 1000, armour: "concrete", sight: 8, weapons: []),
        (building: "soviet_yard", hit_points: 1000, armour: "concrete", sight: 8, weapons: []),
        (building: "allied_power", hit_points: 400, armour: "concrete", sight: 4, weapons: []),
        (building: "soviet_power", hit_points: 400, armour: "concrete", sight: 4, weapons: []),
        (building: "allied_refinery", hit_points: 600, armour: "concrete", sight: 5, weapons: []),
        (building: "soviet_refinery", hit_points: 600, armour: "concrete", sight: 5, weapons: []),
        (building: "allied_barracks", hit_points: 400, armour: "concrete", sight: 5, weapons: []),
        (building: "soviet_barracks", hit_points: 400, armour: "concrete", sight: 5, weapons: []),
        (building: "allied_factory", hit_points: 600, armour: "concrete", sight: 5, weapons: []),
        (building: "soviet_factory", hit_points: 600, armour: "concrete", sight: 5, weapons: []),
        (building: "allied_radar", hit_points: 400, armour: "concrete", sight: 8, weapons: []),
        (building: "soviet_radar", hit_points: 400, armour: "concrete", sight: 8, weapons: []),
        (building: "turret", hit_points: 300, armour: "concrete", sight: 6, weapons: ["cannon"]),

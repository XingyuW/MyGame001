// M4 fixture: combat definitions for the tests, resolved against units_combat.ron and
// economy_combat.ron. The values are fixture data, independent of the production balance in
// assets/data/combat.ron (invariant I10). They cover every case of equation 2: the bullet deals
// 20 x 1 / 100 = 0.2 to plate, raised to 1, and nothing to concrete (versus 0); the armour
// piercing shell deals 25 x 30 / 100 = 7.5 to soft targets, rounded down to 7; and the high
// explosive deals more than its base damage to soft targets (150 %). The turret's sight (3 cells)
// is shorter than its range (6 cells), so it fires beyond its own sight only at enemies other
// units of its owner see.
//
// Schema version 2 (RA3) with the values that leave every rule of M4 as it was: warheads without
// a spread that damage walls and trees, weapons without a minimum range, with a burst of 1, for
// both layers and without scatter, the elite weapons equal to the weapons, no air range bonus,
// every target on land and on water attacked alike, nothing underwater, organic or a wall, and
// no effects.
(
    schema_version: 2,
    armour_classes: ["soft", "plate", "concrete"],
    warheads: [
        (
            id: "bullet",
            versus: [
                (armour: "soft", percent: 100),
                (armour: "plate", percent: 1),
                (armour: "concrete", percent: 0),
            ],
            cell_spread: 0,
            percent_at_max: 100,
            wall: 1,
            wood: 1,
        ),
        (
            id: "ap",
            versus: [
                (armour: "plate", percent: 100),
                (armour: "soft", percent: 30),
                (armour: "concrete", percent: 50),
            ],
            cell_spread: 0,
            percent_at_max: 100,
            wall: 1,
            wood: 1,
        ),
        (
            id: "he",
            versus: [
                (armour: "soft", percent: 150),
                (armour: "plate", percent: 40),
                (armour: "concrete", percent: 75),
            ],
            cell_spread: 0,
            percent_at_max: 100,
            wall: 1,
            wood: 1,
        ),
    ],
    weapons: [
        (
            id: "rifle",
            damage: 20,
            range: 768,
            reload: 10,
            warhead: "bullet",
            projectile_speed: 0,
            min_range: 0,
            burst: 1,
            anti_air: 1,
            anti_ground: 1,
            scatter: 0,
        ),
        (
            id: "cannon",
            damage: 25,
            range: 1024,
            reload: 20,
            warhead: "ap",
            projectile_speed: 128,
            min_range: 0,
            burst: 1,
            anti_air: 1,
            anti_ground: 1,
            scatter: 0,
        ),
        (
            id: "howitzer",
            damage: 40,
            range: 1536,
            reload: 30,
            warhead: "he",
            projectile_speed: 256,
            min_range: 0,
            burst: 1,
            anti_air: 1,
            anti_ground: 1,
            scatter: 0,
        ),
    ],
    units: [
        (unit: "rifleman", hit_points: 100, armour: "soft", sight: 5, weapons: ["rifle"],
         elite_weapons: ["rifle"], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, underwater: 0, organic: 0),
        (unit: "tank", hit_points: 300, armour: "plate", sight: 6, weapons: ["cannon"],
         elite_weapons: ["cannon"], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, underwater: 0, organic: 0),
        (unit: "crawler", hit_points: 50, armour: "soft", sight: 2, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, underwater: 0, organic: 0),
        (unit: "harvester", hit_points: 200, armour: "plate", sight: 3, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, underwater: 0, organic: 0),
    ],
    buildings: [
        (building: "yard", hit_points: 500, armour: "concrete", sight: 4, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "power", hit_points: 200, armour: "concrete", sight: 3, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "refinery", hit_points: 300, armour: "concrete", sight: 3, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "barracks", hit_points: 200, armour: "concrete", sight: 3, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "factory", hit_points: 300, armour: "concrete", sight: 3, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "fence", hit_points: 50, armour: "concrete", sight: 0, weapons: [],
         elite_weapons: [], air_range_bonus: 0, land_targeting: 0, naval_targeting: 5, wall: 0),
        (building: "turret", hit_points: 400, armour: "concrete", sight: 3, weapons: ["howitzer"],
